---
import Button from "./button.astro";
import Logo from "./logo.astro";
---

<script>
    /* Styling link for current page */

    let currentPath = globalThis.location.pathname;
    if (currentPath.endsWith("/")) {
        // Normalize away trailing slash (Cloudflare 308s directory paths to trailing slash equiv e.g. /archive --> /archive/ )
        currentPath = currentPath.slice(0, -1);
    }

    const navLinks = document.querySelectorAll(
        `.nav-button-group > a[href="${currentPath}"], .mobile-overlay-menu > a[href="${currentPath}"]`
    );

    for (const link of navLinks) {
        link.classList.add("current");
    }

    /* Mobile nav open/close */

    const navTrigger = document.querySelector(
        "#mobile-overlay-trigger"
    ) as HTMLButtonElement;

    const navClose = document.querySelector(
        "#mobile-overlay-close"
    ) as HTMLButtonElement;

    const body = document.querySelector("body") as HTMLElement;
    const nav = document.querySelector("nav") as HTMLElement;

    let bodyOverflowStyle: string;
    let scrollPosition: [number, number];

    navTrigger.addEventListener("click", () => {
        // TODO eventually implement sticky header such that preserving scroll actually matters
        bodyOverflowStyle = body.style.overflow;
        body.style.overflow = "hidden";
        scrollPosition = [globalThis.scrollX, globalThis.scrollY];
        globalThis.scrollTo(0, 0);

        nav.dataset.mobileMenuOpen = "true";
    });

    const onClose = () => {
        delete nav.dataset.mobileMenuOpen;
        body.style.overflow = bodyOverflowStyle || "initial";

        if (scrollPosition) {
            globalThis.scrollTo(...scrollPosition);
        }
    };

    navClose.addEventListener("click", onClose);

    const mediaQueryList = globalThis.matchMedia(
        "not all and (max-width: 40rem)"
    );

    function handleOrientationChange(ev: MediaQueryList | MediaQueryListEvent) {
        if (ev.matches) {
            onClose();
        }
    }

    handleOrientationChange(mediaQueryList);
    mediaQueryList.addEventListener("change", handleOrientationChange);
</script>

<style>
    /* grouping layout styles here; nav as a coordinator ruleset TODO revisit / keep thinking about this pattern */
    nav {
        .nav-base {
            align-items: center;
            display: flex;
            gap: var(--spacing-two-rem);
            height: 64px; /* Prevent inadvertent stretching, solved for height jitter when opening and closing mobile nav */
        }

        .nav-button-group,
        .mobile-overlay-close {
            /*
                Unfortunate, but helps make logo link and rest of nav buttons
                visually aligned
            */
            margin-top: -6px;
        }

        /* hide expanded nav mobile-first */
        .nav-button-group,
        .mobile-overlay {
            display: none;
        }

        @media (max-width: 40rem) {
            &[data-mobile-menu-open="true"] {
                display: block;

                .nav-base {
                    display: none;
                }

                .mobile-overlay {
                    display: block;
                }
            }
        }

        @media (min-width: 40rem) {
            gap: var(--spacing-four-rem);

            .mobile-overlay,
            #mobile-overlay-trigger {
                display: none;
            }

            .nav-button-group {
                display: flex;
            }
        }
    }

    .nav-button-group {
        flex-direction: row;
        gap: var(--spacing-three-rem);

        > .current {
            position: relative;
            pointer-events: none;

            /* standard Button hover/active styles */
            background-color: var(--color-accent-900);
            border-style: outset;
            color: var(--color-accent-100);

            &::before {
                color: var(--color-primary-400);
                content: "*";
                font-size: var(--font-size-4xl);
                font-weight: 600;
                position: absolute;
                left: calc(50% - 0.25ch);
                top: calc(var(--spacing-threequarter-rem) * -1);
            }
        }
    }

    .mobile-overlay {
        background-color: var(--color-accent-1000);
    }

    .mobile-overlay-header {
        align-items: center;
        display: flex;
        flex-direction: row;
        gap: var(--spacing-six-rem);
    }

    #mobile-overlay-close {
        /* resets */

        background-color: transparent;
        border-width: 0;
        padding: 0;
        border-style: solid;

        /* end resets */
        color: var(--color-accent-600);
        font-size: var(--font-size-5xl);
        font-weight: bold;
        text-decoration: none;
        margin-top: -4px; /* tighten up alignment with logo link */

        &:hover {
            color: var(--color-accent-200);
        }
    }

    .mobile-overlay-menu {
        padding-top: var(--spacing-six-rem);
        margin-left: calc(var(--spacing-two-rem) * -1);
        margin-right: calc(var(--spacing-two-rem) * -1);

        a {
            display: block;
            color: var(--color-accent-600);
            font-weight: 600;
            font-size: var(--font-size-3xl);
            text-decoration: none;
            text-align: center;
            padding: var(--spacing-one-rem) var(--spacing-two-px);

            &:hover {
                text-decoration: underline;
            }

            &.current {
                color: var(--color-primary-700);
                background-color: var(--color-accent-100);
                pointer-events: none;
            }

            & + * {
                margin-top: var(--spacing-three-rem);
            }
        }
    }

    .logo-link {
        /*
            TODO file bug? needed important b/c styles were applying in dev, but not in prod (build)
            that is, padding rules on .subpage-layout > main were taking precedence only once built
        */
        font-size: var(--font-size-4xl) !important;
        /* 
            roundabout-ass way to say 18px, experimentally arrived at ... assuredly a better way, will figure out later
            point is to make logo and nav buttons look more visually aligned    
        */
        margin-top: calc(var(--spacing-onedotfive-rem) * -0.75);
        text-decoration: none;

        &:active,
        &:hover {
            box-shadow: 0 0.05em 0 var(--color-accent-600);
            color: var(--color-accent-600);
        }

        @media (min-width: 40rem) {
            font-size: var(--font-size-5xl) !important;
        }
    }
</style>
<nav
    class="GC_Subnav"
    data-mobile-menu-open={false}
>
    <div class="nav-base">
        <h1>
            <Logo
                as="a"
                class="logo-link"
                href="/"
                imgWidth={56}
            />
        </h1>

        <div class="nav-button-group">
            <Button
                as="a"
                href="/about"
            >
                About
            </Button>
            <Button
                as="a"
                href="/projects"
            >
                Projects
            </Button>
            <Button
                as="a"
                href="/blog"
            >
                Blog
            </Button>
        </div>
        <Button id="mobile-overlay-trigger">Menu</Button>
    </div>

    <div class="mobile-overlay">
        <div class="mobile-overlay-header">
            <h1>
                <Logo
                    as="a"
                    class="logo-link"
                    href="/"
                    imgWidth={56}
                />
            </h1>
            <button
                id="mobile-overlay-close"
                type="button"
                >X</button
            >
        </div>

        <div class="mobile-overlay-menu">
            <a href="/about">About</a>
            <a href="/projects">Projects</a>
            <a href="/blog">Blog</a>
        </div>
    </div>
</nav>
