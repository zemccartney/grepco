---
import type { ComponentProps } from "astro/types";

import SubpageLayout from "./subpage.astro";

type Props = ComponentProps<typeof SubpageLayout>;

const { description, title, ...rest } = Astro.props;
---

<style>
    .subpage-layout-overrides {
        main {
            height: inherit;
            display: flex;
            flex-direction: column;
            /* unset subpage padding, allow background color to extend to the edges of the screen */
            /*
                TODO file bug? needed important b/c styles were applying in dev, but not in prod (build)
                that is, padding rules on .subpage-layout > main were taking precedence only once built
                
                approaches tried:
                - just targeting .subpage-layout
                - targeting .subpage-layout-overrides and passing class to layout
            */
            padding: 0 !important;

            .content {
                flex: 1;
                margin-top: calc(var(--spacing-two-rem));
                background-color: var(--color-primary-900);
                padding-bottom: var(--spacing-two-rem);
                padding-left: var(--spacing-two-rem);
                padding-right: var(--spacing-two-rem);
            }
        }
    }

    /* TODO Abstract into central component, part of theme */
    .page-title {
        color: var(--color-primary-900);
        font-size: var(--font-size-4xl);
        font-style: italic;
        letter-spacing: 0.05em;
        max-width: 60rem;
        margin-left: auto;
        margin-right: auto;
        text-align: center;
        text-transform: uppercase;
        text-wrap: balance;

        @media (min-width: 40rem) {
            font-size: var(--font-size-7xl);
        }
    }
</style>

<SubpageLayout
    class="subpage-layout-overrides"
    description={description || "GrepCo's blog"}
    title={title || "Blog"}
    {...rest}
>
    {
        /* blog-layout-header id used for labelled-by reference (see blog post detail) */
    }
    <h1
        class="page-title"
        id="blog-layout-header"
    >
        <slot name="title" />
    </h1>
    <section class="content">
        <slot />
    </section>
</SubpageLayout>
