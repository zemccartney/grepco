---
import type { ComponentProps } from "astro/types";
import type { ClassValue } from "clsx";

import SubpageNav from "../components/subpage-nav.astro";
import BaseLayout from "./base.astro";

interface Props extends ComponentProps<typeof BaseLayout> {
    class?: ClassValue;
}

// ...rest required for styling
// https://docs.astro.build/en/guides/styling/#passing-a-class-to-a-child-component
// "Using the default scoped style strategy, you must also pass the data-astro-cid-* attribute.
// You can do this by passing the ...rest of the props to the component."
const { class: className, ...rest } = Astro.props;
---

<style>
    .subpage-layout {
        /* 
            All this, plus the 100% height rules on html and body,
            allows for page sections expanding to fill remaining height
            (see light-blue background main section on blog pages)
            
            https://stackoverflow.com/a/24979148
        */
        height: 100%;
        display: flex;
        flex-direction: column;

        /*
            page components own global padding to simplify changing
            background color of header on opening mobile nav
        */
        > main,
        > header {
            padding-left: var(--spacing-two-rem);
            padding-right: var(--spacing-two-rem);
        }

        > header {
            padding-top: var(--spacing-two-rem);
        }

        > main {
            padding-bottom: var(--spacing-two-rem);
        }
    }

    header {
        max-width: 44rem;
        margin-bottom: var(--spacing-four-rem);

        &:has(nav[data-mobile-menu-open="true"]) {
            background-color: var(--color-accent-1000);
            padding-bottom: 2px; /* prevent hiding logo link box shadow */
            position: fixed;
            top: 0;
            left: 0;
            isolation: isolate;
            z-index: 1;
            width: 100%;
            height: 100%;
        }

        @media (min-width: 40rem) {
            /* 
                needed to prevent heading from collapsing horizontally, such that
                background color of mobile nav doesn't fill space
            */
            margin-left: auto;
            margin-right: auto;
        }

        @media (min-width: 80rem) {
            max-width: var(--spacing-fortyeight-rem);
        }
    }
</style>

<BaseLayout>
    {/* TODO Just pipe classes down to root? */}
    <div
        class:list={["subpage-layout", className]}
        {...rest}
    >
        <header>
            <SubpageNav />
        </header>
        <main>
            <slot />
        </main>
    </div>
</BaseLayout>
