---
import { getEntryGitInfo } from "@it-astro:content/git";
import { getCollection } from "astro:content";

import BlogLayout from "../../layouts/blog.astro";
import * as Utils from "../../utils";

const posts = await getCollection("posts", ({ id }) => {
    return (
        import.meta.env.DEV ||
        import.meta.env.IS_PREVIEW_ENV ||
        !id.startsWith("drafts")
    );
});
---

<style>
    .posts-container {
        max-width: 48rem;
        margin-left: auto;
        margin-right: auto;
        padding: var(--spacing-two-rem) var(--spacing-one-rem);

        > article:not(:first-child) {
            margin-top: var(--spacing-two-rem);
        }

        @media (min-width: 40rem) {
            padding: var(--spacing-four-rem) var(--spacing-two-rem);
        }
    }

    article {
        a {
            text-decoration: none;
            color: var(--color-primary-300);
            text-wrap: balance;
            display: block;

            h2 {
                /*
                    Needed to unset default from global.css

                    TODO Possible to allow NOT doing this? :where / :is?
                */
                font-size: var(--font-size-3xl);
                font-weight: 900;
            }

            &:hover {
                text-decoration: underline;
            }
        }

        time {
            color: var(--color-primary-100);
            font-size: var(--font-size-base);
        }

        @media (min-width: 40rem) {
            h2 {
                font-size: var(--font-size-5xl);
            }

            time {
                font-size: var(--font-size-lg);
            }
        }
    }
</style>

<BlogLayout>
    <Fragment slot="title">Blog</Fragment>
    <div class="posts-container">
        {
            posts.map((post) => (
                <article>
                    <a href={`/blog/${Utils.getPostDisplayId(post)}`}>
                        <h2>{post.data.title}</h2>
                    </a>
                    {async () => {
                        const git = await getEntryGitInfo("posts", post.id);
                        const publishedOn = git?.earliest ?? new Date();

                        return (
                            <time datetime={publishedOn.toISOString()}>
                                {Utils.displayDatetimeEastern(
                                    publishedOn,
                                    "long"
                                )}
                            </time>
                        );
                    }}
                </article>
            ))
        }
    </div>
</BlogLayout>
