---
import {
    getEntryGitInfo,
    getLatestCommitDate,
    getOldestCommitDate
} from "@it-astro:content/git";
import { getCollection, render } from "astro:content";

import BlogLayout from "../../layouts/blog.astro";
import * as Utils from "../../utils";

export const getStaticPaths = async () => {
    const posts = await getCollection("posts", ({ id }) => {
        return (
            import.meta.env.DEV ||
            import.meta.env.IS_PREVIEW_ENV ||
            !id.startsWith("drafts")
        );
    });

    return posts.map((post) => ({
        params: { slug: Utils.getPostDisplayId(post) },
        props: { post }
    }));
};

const { post } = Astro.props;
const { Content: Body } = await render(post);

const git = await getEntryGitInfo("posts", post.id);
const publishedOn = git?.earliest ?? new Date();
const updatedOn = git?.latest ?? new Date();

console.log(
    {
        git,
        id: post.id,
        late: await getLatestCommitDate(post),
        old: await getOldestCommitDate(post)
    },
    "WHYYYYY"
);
---

<style>
    .frontmatter {
        border-bottom: 2px dashed var(--color-primary-200);
        color: var(--color-accent-400);
        font-family: var(--font-mono);
        margin-left: auto;
        margin-right: auto;
        max-width: var(--spacing-thirtytwo-rem);
        padding: var(--spacing-half-rem);
        padding-left: 0;

        /*
            selector needed to override global styles default on p elements
        */
        * {
            font-size: var(--font-size-base);
        }

        .property {
            color: var(--color-primary-bg);
            display: inline-block;
            margin-right: var(--spacing-one-px);
        }

        @media (min-width: 40rem) {
            padding: var(--spacing-one-rem);
        }
    }

    .post-content {
        color: var(--color-primary-bg);
        font-family: var(--font-sans);
        line-height: 1.65;
        margin-top: var(--spacing-four-rem);

        @media (min-width: 40rem) {
            font-size: var(--font-size-2xl);
            margin-top: var(--spacing-six-rem);
        }

        /*
            Layout rules, assume only relevant to top level of layout, that container elements
            will more often than not want to be responsible for spacing/laying out their own children
        */
        > * {
            /*

                highlighted elements

                a little wonky here: width-capping and centering elements
                individually to support select elements taking up more horizontal
                space. for example, better to allow code blocks to expand more
                to avoid horizontal scroll / wrapping as much as possible
            */
            margin-left: auto;
            margin-right: auto;

            &:not(.expressive-code) {
                max-width: 40rem;
            }

            &:is(.expressive-code) {
                max-width: var(--spacing-sixtyfour-rem);

                @media (max-width: 40rem) {
                    margin-left: calc(var(--spacing-two-rem) * -1);
                    margin-right: calc(var(--spacing-two-rem) * -1);
                }
            }

            /* 

                vertical rhythm

                & + * means apply only if element (*) follows another 
                https://alistapart.com/article/axiomatic-css-and-lobotomized-owls/
            */

            &:not(h2, h3) + * {
                margin-top: 1.75em;
            }

            &:is(h2):not(:first-child) {
                margin-top: 1.5em;
            }

            &:is(h2):not(:last-child) {
                margin-bottom: 0.75em;
            }

            &:is(h3):not(:first-child) {
                margin-top: 1.5em;
            }

            &:is(h3):not(:last-child) {
                margin-bottom: 0.5em;
            }

            /*

                vertical rhythm exceptions

                elements for which found more + symmetrical spacing
                tended to look cleaner e.g. hrs, aligned with using
                to mark boundaries between sections i.e. break
                in rhythm
            */
            &:is(hr) {
                margin-top: 3em;
                margin-bottom: 3em;
            }

            &:is(hr) + * {
                margin-top: 0;
            }

            &:is(.expressive-code) {
                /* using rem since .expressive-code doesn't have its own font size */
                margin-top: 4rem;
                margin-bottom: 4rem;
            }

            &:is(.expressive-code) + * {
                margin-top: 0;
            }
        }

        /* section heading */
        h2 {
            border-bottom: var(--spacing-quarter-px) solid
                var(--color-accent-500);
            font-family: var(--font-sans);
            font-size: var(--font-size-5xl);
            letter-spacing: 0.035em;
            text-wrap: balance;
        }

        /* sub-section heading */
        h3 {
            color: var(--color-accent-500);
            font-family: var(--font-sans);
            font-size: var(--font-size-2xl);
            font-style: italic;
            text-transform: uppercase;
        }

        /*
            recreates list styles in layouts/typography (handles ol, too)

            TODO find some way to consolidate?
        */
        ul,
        ol {
            padding-inline-start: var(--spacing-onedotfive-px);

            &:is(ol) {
                padding-inline-start: var(--spacing-two-px);

                li {
                    padding-inline-start: 0.75ch;
                }
            }

            li {
                padding-inline-start: 1ch;
                margin-top: 0.35em;

                &::marker {
                    color: var(--color-accent-500);
                    font-family: var(--font-sans);
                }
            }

            &:is(ul) {
                li {
                    &::marker {
                        content: "*";
                        font-size: 1.15em;
                        font-weight: bold;
                    }
                }
            }

            @media (min-width: 40rem) {
                padding-inline-start: var(--spacing-three-px);

                &:is(ol) {
                    padding-inline-start: 54px;
                }
            }
        }

        a {
            color: var(--color-link);

            &:hover,
            &:active {
                color: var(--color-link-active);
            }
        }

        hr {
            background-color: var(--color-accent-500);
            border: none; /* reset border styles so visible color is exactly height specified */
            height: 2px;
            width: 65%;
            margin-left: auto;
            margin-right: auto;
        }

        .expressive-code {
            code {
                font-size: var(--font-size-base);

                @media (min-width: 40rem) {
                    font-size: var(--font-size-xl);
                }
            }

            /* tighten line numbers */
            .gutter .ln {
                padding-inline: 1.5ch;
                padding-inline-start: 1ch;
            }
        }
    }
</style>

<BlogLayout
    description={post.data.description}
    title={post.data.title}
>
    <Fragment slot="title">
        {post.data.title}
    </Fragment>
    {
        /*
            aria-labelledby since article's h1 is placed outside of article in blog layout,
            doubling as both the page and article h1
        */
    }
    <article aria-labelledby="blog-layout-header">
        <header class="frontmatter">
            <p>
                <span class="property">published_on:</span>
                {Utils.displayDatetimeEastern(publishedOn)}
            </p>
            {
                updatedOn > publishedOn && (
                    <p>
                        <span class="property">updated_on:</span>
                        {Utils.displayDatetimeEastern(updatedOn)}
                    </p>
                )
            }
        </header>
        <div class="post-content">
            <Body />
        </div>
    </article>
</BlogLayout>
